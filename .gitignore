# Large sim outputs are regenerable on VMs, not committed.
# Plot-ready CSVs under results/v<version>_baseline/ ARE committed.
raw_results/
results/raw_v*/
results/v*/*.obj
results/v*/*.pkl
results/v*/*.sim
results/v*/*.msim

# Top-level results/ is a transient VM-run scratch area.
# Freeze plot-ready snapshots under results/v<version>_baseline/ instead.
results/*.obj
results/*.pkl
results/*.sim
results/*.msim
results/*.csv
# ...but paper-ready aggregate tables are tracked
!results/table_s1.csv
!results/table_s2.csv
!results/table_s3_costing.csv
# Plot-ready scenario summaries for Figs 1-5 (produced by run_scenarios.py)
!results/scens_timeseries.csv
!results/scens_cumulative.csv
!results/scens_paired.csv
!results/scens_per_sim.csv
# Plot-ready calibration diagnostics for Fig S2 (produced by run_calibration.py extract)
!results/figS2_*.csv
# Plot-ready analyzer arrays for Fig S3 (produced by run_age_causal.py)
!results/age_causal_rwanda.obj

# Diagnostic sweeps produce per-cancer row dumps that are large and
# regenerable. Keep the small aggregates (summary.csv, residual_*.csv,
# q1_change_year.csv) committed for the write-up.
results/diagnostic*/cancer_rows.csv
results/*.log
results/diagnostic_smoketest/
# Scratch folder for the vax-off re-run of 'No interventions';
# its rows are merged into results/diagnostic_normalized/cancer_rows.csv
# by analyze_residual.py.
results/diagnostic_normalized_novax/

# Sensitivity-sweep folders (reviewer response); regenerable via run_sensitivity.py
results/sens_*/
# ...but plot-ready paired-diff CSVs for Figs S4 and S5 are tracked
!results/sens_txv_year/
results/sens_txv_year/*
!results/sens_txv_year/scens_paired.csv
!results/sens_workforce/
results/sens_workforce/*
!results/sens_workforce/scens_paired.csv

# Archives
results/*.zip
*.zip

# Local artifacts
figures/

# Manuscript (tracked separately)
*.docx
*.docx.md

# Python
__pycache__/
*.py[cod]
.DS_Store
